# ==========================================
# B-Plan: BNBU 校园日程助手 - 本地环境变量配置模板
# 复制一份本文件并重命名为 .env 进行本地真实联调
# ==========================================

# 1. 教务系统 (GSAS: https://gsas.bnbu.edu.cn)
BNBU_GSAS_USERNAME=
BNBU_GSAS_PASSWORD=

# 2. iSpace 教学平台 (Moodle: https://ispace.bnbu.edu.cn)
BNBU_ISPACE_USERNAME=
BNBU_ISPACE_PASSWORD=
# 可选：已登录的 Moodle Session 标识（如 MoodleSession Cookie）
BNBU_ISPACE_SESSION_COOKIE=

# 3. 校园邮箱 (BNBU Student Email)
BNBU_MAIL_ADDRESS=
BNBU_MAIL_PASSWORD=
BNBU_MAIL_IMAP_SERVER=mail.bnbu.edu.cn
BNBU_MAIL_IMAP_PORT=993
BNBU_MAIL_SMTP_SERVER=mail.bnbu.edu.cn
BNBU_MAIL_SMTP_PORT=465

# 4. 开发与调试配置
DEBUG=True
LOG_LEVEL=INFO
